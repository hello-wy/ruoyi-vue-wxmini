<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wxmini.mapper.UserReferralMapper">

    <resultMap type="UserReferral" id="UserReferralResult">
        <result property="id" column="id"/>
        <result property="inviterUserId" column="inviter_user_id"/>
        <result property="inviteeUserId" column="invitee_user_id"/>
        <result property="inviteCode" column="invite_code"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap type="UserReferralVo" id="UserReferralVoResult">
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="phone" column="phone"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="inviterUserId" column="inviter_user_id"/>
        <result property="inviterUserName" column="inviter_user_name"/>
        <result property="inviterPhone" column="inviter_phone"/>
        <result property="inviteCode" column="invite_code"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectUserReferralVo">
        select id, inviter_user_id, invitee_user_id, invite_code, create_time from user_referral
    </sql>

    <insert id="insertUserReferral" parameterType="UserReferral" useGeneratedKeys="true" keyProperty="id">
        insert into user_referral
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="inviterUserId != null and inviterUserId != ''">inviter_user_id,</if>
            <if test="inviteeUserId != null and inviteeUserId != ''">invitee_user_id,</if>
            <if test="inviteCode != null and inviteCode != ''">invite_code,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="inviterUserId != null and inviterUserId != ''">#{inviterUserId},</if>
            <if test="inviteeUserId != null and inviteeUserId != ''">#{inviteeUserId},</if>
            <if test="inviteCode != null and inviteCode != ''">#{inviteCode},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <select id="selectReferralVoListByInviterUserId" parameterType="String" resultMap="UserReferralVoResult">
        select 
            ui.user_id,
            ui.user_name,
            ui.phone,
            ui.avatar_url,
            ur.inviter_user_id,
            ur.invite_code,
            ur.create_time
        from user_referral ur
        left join user_info ui on ur.invitee_user_id = ui.user_id
        where ur.inviter_user_id = #{inviterUserId}
        order by ur.create_time desc
    </select>

    <select id="selectReferralByInviteeUserId" parameterType="String" resultMap="UserReferralResult">
        <include refid="selectUserReferralVo"/>
        where invitee_user_id = #{inviteeUserId}
    </select>

    <select id="selectReferralCountByInviterUserId" parameterType="String" resultType="int">
        select count(1) from user_referral where inviter_user_id = #{inviterUserId}
    </select>

    <select id="selectUserReferralList" parameterType="UserReferral" resultMap="UserReferralResult">
        <include refid="selectUserReferralVo"/>
        <where>
            <if test="inviterUserId != null and inviterUserId != ''">and inviter_user_id = #{inviterUserId}</if>
            <if test="inviteeUserId != null and inviteeUserId != ''">and invitee_user_id = #{inviteeUserId}</if>
            <if test="inviteCode != null and inviteCode != ''">and invite_code = #{inviteCode}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectUserReferralVoList" parameterType="UserReferralVo" resultMap="UserReferralVoResult">
        select 
            ur.invitee_user_id as user_id,
            ui_ee.user_name as user_name,
            ui_ee.phone as phone,
            ui_ee.avatar_url as avatar_url,
            ur.inviter_user_id as inviter_user_id,
            ui_er.user_name as inviter_user_name,
            ui_er.phone as inviter_phone,
            ur.invite_code as invite_code,
            ur.create_time as create_time
        from user_referral ur
        left join user_info ui_ee on ur.invitee_user_id = ui_ee.user_id
        left join user_info ui_er on ur.inviter_user_id = ui_er.user_id
        <where>
            <if test="inviteCode != null and inviteCode != ''">
                and ur.invite_code = #{inviteCode}
            </if>
            <if test="userName != null and userName != ''">
                and ui_ee.user_name like concat('%', #{userName}, '%')
            </if>
            <if test="phone != null and phone != ''">
                and ui_ee.phone like concat('%', #{phone}, '%')
            </if>
            <if test="inviterUserName != null and inviterUserName != ''">
                and ui_er.user_name like concat('%', #{inviterUserName}, '%')
            </if>
            <if test="inviterPhone != null and inviterPhone != ''">
                and ui_er.phone like concat('%', #{inviterPhone}, '%')
            </if>
        </where>
        order by ur.create_time desc
    </select>
</mapper>
