<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wxmini.mapper.WxUserProfileMapper">

    <resultMap id="WxUserProfileVoResult" type="com.ruoyi.wxmini.domain.vo.WxUserProfileVo">
        <result property="userInfoId" column="uid"/>
        <result property="displayName" column="display_name"/>
        <result property="userName" column="user_name"/>
        <result property="phone" column="phone"/>
        <result property="birthday" column="birthday"/>
        <result property="realName" column="real_name"/>
        <result property="idCard" column="id_card"/>
        <result property="nickName" column="nick_name"/>
        <result property="gender" column="gender"/>
        <result property="age" column="age"/>
        <result property="companyName" column="company_name"/>
        <result property="companyAddress" column="company_address"/>
        <result property="companyPosition" column="company_position"/>
        <result property="industry" column="industry"/>
        <result property="workYears" column="work_years"/>
        <result property="personalIntro" column="personal_intro"/>
        <result property="availableTime" column="available_time"/>
        <result property="workExperience" column="work_experience"/>
        <result property="verified" column="verified"/>
        <result property="isRealnameAuth" column="is_realname_auth"/>
        <result property="userType" column="user_type"/>
    </resultMap>

    <resultMap id="StudentListVoResult" type="com.ruoyi.system.domain.vo.StudentListVo">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="displayName" column="display_name"/>
        <result property="realName" column="real_name"/>
        <result property="phone" column="phone"/>
        <result property="userType" column="user_type"/>
        <result property="assignmentId" column="assignment_id"/>
        <result property="ownerDeptId" column="owner_dept_id"/>
        <result property="ownerDeptName" column="owner_dept_name"/>
        <result property="boundUserId" column="bound_user_id"/>
        <result property="boundUserName" column="bound_user_name"/>
        <result property="boundUserNickName" column="bound_nick_name"/>
        <result property="boundUserPhone" column="bound_phone"/>
        <result property="boundUserAdminLevel" column="bound_admin_level"/>
        <result property="boundDeptName" column="bound_dept_name"/>
    </resultMap>

    <resultMap id="StudentDetailVoResult" type="com.ruoyi.system.domain.vo.StudentDetailVo">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="displayName" column="display_name"/>
        <result property="userName" column="user_name"/>
        <result property="phone" column="phone"/>
        <result property="birthday" column="birthday"/>
        <result property="realName" column="real_name"/>
        <result property="nickName" column="nick_name"/>
        <result property="gender" column="gender"/>
        <result property="age" column="age"/>
        <result property="userType" column="user_type"/>
        <result property="companyName" column="company_name"/>
        <result property="companyAddress" column="company_address"/>
        <result property="companyPosition" column="company_position"/>
        <result property="industry" column="industry"/>
        <result property="workYears" column="work_years"/>
        <result property="personalIntro" column="personal_intro"/>
        <result property="studentSituation" column="student_situation"/>
    </resultMap>

    <sql id="AdminStudentAccessScope">
        <choose>
            <when test="accessScope == null or accessScope.fullAccess">
                1 = 1
            </when>
            <when test="accessScope.employeeAccess">
                sa.id is not null
                and (
                    sa.employee_user_id = #{accessScope.currentUserId}
                    or (
                        sa.employee_user_id is null
                        <choose>
                            <when test="accessScope.visibleDeptIds != null and accessScope.visibleDeptIds.size() > 0">
                                and sa.owner_dept_id in
                                <foreach collection="accessScope.visibleDeptIds" item="deptId" open="(" separator="," close=")">#{deptId}</foreach>
                            </when>
                            <otherwise>
                                and 1 = 0
                            </otherwise>
                        </choose>
                    )
                )
            </when>
            <otherwise>
                sa.id is not null
                and (
                    (
                        sa.employee_user_id is not null
                        <choose>
                            <when test="accessScope.visibleUserIds != null and accessScope.visibleUserIds.size() > 0">
                                and sa.employee_user_id in
                                <foreach collection="accessScope.visibleUserIds" item="userId" open="(" separator="," close=")">#{userId}</foreach>
                            </when>
                            <otherwise>
                                and 1 = 0
                            </otherwise>
                        </choose>
                    )
                    or (
                        sa.employee_user_id is null
                        <choose>
                            <when test="accessScope.visibleDeptIds != null and accessScope.visibleDeptIds.size() > 0">
                                and sa.owner_dept_id in
                                <foreach collection="accessScope.visibleDeptIds" item="deptId" open="(" separator="," close=")">#{deptId}</foreach>
                            </when>
                            <otherwise>
                                and 1 = 0
                            </otherwise>
                        </choose>
                    )
                )
            </otherwise>
        </choose>
    </sql>

    <select id="selectProfileDetailByUserId" parameterType="String" resultMap="WxUserProfileVoResult">
        select ui.id as uid,
               case
                   when ui.real_name is not null and ui.real_name != '' then ui.real_name
                   when ui.phone is not null and length(ui.phone) = 11 then concat(substring(ui.phone, 1, 3), '****', substring(ui.phone, 8, 4))
                   else ''
               end as display_name,
               ui.user_name,
               ui.user_type,
               ui.phone,
               ui.birthday,
               ui.is_realname_auth,
               ui.real_name,
               case
                   when ui.is_realname_auth = 1 then ui.id_card
                   else ''
               end as id_card,
               up.nick_name,
               up.gender,
               up.age,
               up.company_name,
               up.company_address,
               up.company_position,
               up.industry,
               up.work_years,
               up.personal_intro,
               up.available_time,
               up.work_experience,
               case
                   when ui.is_realname_auth = 1 then 1
                   else 0
               end as verified
        from user_info ui
                 left join wx_user_profile up on up.uid = ui.id
        where ui.user_id = #{userId}
        limit 1
    </select>

    <select id="selectAdminStudentList" parameterType="com.ruoyi.system.domain.bo.StudentQueryBo" resultMap="StudentListVoResult">
        select ui.id,
               ui.user_id,
               ui.user_type,
               ui.phone,
               up.real_name,
               case
                   when up.real_name is not null and up.real_name != '' then up.real_name
                   when up.nick_name is not null and up.nick_name != '' then up.nick_name
                   else ui.user_name
               end as display_name,
               sa.id as assignment_id,
               sa.owner_dept_id,
               owner_dept.dept_name as owner_dept_name,
               su.user_id as bound_user_id,
               su.user_name as bound_user_name,
               su.nick_name as bound_nick_name,
               su.phonenumber as bound_phone,
               su.admin_level as bound_admin_level,
               bound_dept.dept_name as bound_dept_name
        from user_info ui
                 left join wx_user_profile up on up.uid = ui.id
                 left join student_staff_assignment sa on sa.student_id = ui.id
                 left join sys_dept owner_dept on owner_dept.dept_id = sa.owner_dept_id
                 left join sys_user su on su.user_id = sa.employee_user_id
                 left join sys_dept bound_dept on bound_dept.dept_id = su.dept_id
        <where>
            ui.is_student = 1
            and <include refid="AdminStudentAccessScope"/>
            <if test="realName != null and realName != ''">
                and (
                    up.real_name like concat('%', #{realName}, '%')
                    or up.nick_name like concat('%', #{realName}, '%')
                    or ui.user_name like concat('%', #{realName}, '%')
                )
            </if>
            <if test="phone != null and phone != ''">
                and ui.phone like concat('%', #{phone}, '%')
            </if>
            <if test="assignmentStatus == 'bound'">
                and sa.employee_user_id is not null
            </if>
            <if test="assignmentStatus == 'unbound'">
                <choose>
                    <when test="accessScope != null and accessScope.fullAccess">
                        and (sa.id is null or sa.employee_user_id is null)
                    </when>
                    <otherwise>
                        and sa.id is not null
                        and sa.employee_user_id is null
                    </otherwise>
                </choose>
            </if>
            <if test="boundUserId != null">
                and sa.employee_user_id = #{boundUserId}
            </if>
        </where>
        order by ui.create_time desc, ui.id desc
    </select>

    <select id="selectAdminStudentDetailById" parameterType="Long" resultMap="StudentDetailVoResult">
        select ui.id,
               ui.user_id,
               ui.user_name,
               ui.phone,
               ui.birthday,
               ui.user_type,
               up.real_name,
               up.nick_name,
               up.gender,
               up.age,
               up.company_name,
               up.company_address,
               up.company_position,
               up.industry,
               up.work_years,
               up.personal_intro,
               up.student_situation,
               case
                   when up.real_name is not null and up.real_name != '' then up.real_name
                   when up.nick_name is not null and up.nick_name != '' then up.nick_name
                   else ui.user_name
               end as display_name
        from user_info ui
                 left join wx_user_profile up on up.uid = ui.id
        where ui.id = #{id}
          and ui.is_student = 1
        limit 1
    </select>

    <select id="countAdminStudentById" resultType="int">
        select count(1) from user_info where id = #{id} and is_student = 1
    </select>

    <insert id="updateAdminStudentSituation">
        insert into wx_user_profile (uid, student_situation)
        select ui.id, #{studentSituation}
        from user_info ui
        where ui.id = #{id}
          and ui.is_student = 1
        on duplicate key update student_situation = values(student_situation)
    </insert>
</mapper>
