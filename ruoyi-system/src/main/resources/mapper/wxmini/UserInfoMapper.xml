<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.wxmini.mapper.UserInfoMapper">

    <resultMap type="UserInfo" id="UserInfoResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="userType" column="user_type"/>
        <result property="phone" column="phone"/>
        <result property="birthday" column="birthday"/>
        <result property="openId" column="open_id"/>
        <result property="unionId" column="union_id"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="realName" column="real_name"/>
        <result property="idCard" column="id_card"/>
        <result property="isRealnameAuth" column="is_realname_auth"/>
        <result property="inviteCode" column="invite_code"/>
        <result property="isStudent" column="is_student"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectUserInfoVo">
        select id,
               user_id,
               user_name,
               user_type,
               phone,
               birthday,
               open_id,
               union_id,
               avatar_url,
               real_name,
               id_card,
               is_realname_auth,
               invite_code,
               is_student,
               create_time,
               update_time
        from user_info
    </sql>

    <select id="selectUserInfoList" parameterType="UserInfo" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        <where>
            <if test="userId != null  and userId != ''">and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''">and user_name like concat('%', #{userName}, '%')</if>
            <if test="userType != null">and user_type = #{userType}</if>
            <if test="phone != null  and phone != ''">and phone = #{phone}</if>
            <if test="openId != null  and openId != ''">and open_id = #{openId}</if>
            <if test="unionId != null  and unionId != ''">and union_id = #{unionId}</if>
            <if test="avatarUrl != null  and avatarUrl != ''">and avatar_url = #{avatarUrl}</if>
            <if test="inviteCode != null  and inviteCode != ''">and invite_code = #{inviteCode}</if>
            <if test="isStudent != null">and is_student = #{isStudent}</if>
        </where>
    </select>

    <select id="selectUserInfoById" parameterType="Long" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertUserInfo" parameterType="UserInfo" useGeneratedKeys="true" keyProperty="id">
        insert into user_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="userType != null">user_type,</if>
            <if test="phone != null">phone,</if>
            <if test="openId != null">open_id,</if>
            <if test="unionId != null">union_id,</if>
            <if test="avatarUrl != null">avatar_url,</if>
            <if test="realName != null and realName != ''">real_name,</if>
            <if test="idCard != null and idCard != ''">id_card,</if>
            <if test="isRealnameAuth != null">is_realname_auth,</if>
            <if test="inviteCode != null and inviteCode != ''">invite_code,</if>
            <if test="isStudent != null">is_student,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null and userId != ''">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="userType != null">#{userType},</if>
            <if test="phone != null">#{phone},</if>
            <if test="openId != null">#{openId},</if>
            <if test="unionId != null">#{unionId},</if>
            <if test="avatarUrl != null">#{avatarUrl},</if>
            <if test="realName != null and realName != ''">#{realName},</if>
            <if test="idCard != null and idCard != ''">#{idCard},</if>
            <if test="isRealnameAuth != null">#{isRealnameAuth},</if>
            <if test="inviteCode != null and inviteCode != ''">#{inviteCode},</if>
            <if test="isStudent != null">#{isStudent},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateUserInfo" parameterType="UserInfo">
        update user_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="userType != null">user_type = #{userType},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="openId != null">open_id = #{openId},</if>
            <if test="unionId != null">union_id = #{unionId},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="realName != null and realName != ''">real_name = #{realName},</if>
            <if test="idCard != null and idCard != ''">id_card = #{idCard},</if>
            <if test="isRealnameAuth != null">is_realname_auth = #{isRealnameAuth},</if>
            <if test="inviteCode != null and inviteCode != ''">invite_code = #{inviteCode},</if>
            <if test="isStudent != null">is_student = #{isStudent},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUserInfoById" parameterType="Long">
        delete
        from user_info
        where id = #{id}
    </delete>

    <delete id="deleteUserInfoByIds" parameterType="String">
        delete from user_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectUserInfoByOpenId" parameterType="String" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        where open_id = #{openId}
    </select>

    <select id="selectUserInfoByUserId" parameterType="String" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        where user_id = #{userId}
    </select>

    <select id="selectUserInfoByInviteCode" parameterType="String" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        where invite_code = #{inviteCode}
    </select>

    <select id="selectUserInfosForUpdate" resultMap="UserInfoResult">
        <include refid="selectUserInfoVo"/>
        where user_id in (#{firstUserId}, #{secondUserId})
        order by user_id for update
    </select>

    <update id="updateBirthdayById">
        update user_info
        set birthday = #{birthday},
            update_time = now()
        where id = #{id}
    </update>

    <update id="markStudentByUserId">
        update user_info
        set is_student = 1,
            update_time = now()
        where user_id = #{userId}
          and is_student = 0
    </update>
</mapper>