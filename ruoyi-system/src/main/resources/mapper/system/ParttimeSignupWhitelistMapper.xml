<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ParttimeSignupWhitelistMapper">

    <resultMap type="ParttimeSignupWhitelist" id="ParttimeSignupWhitelistResult">
        <result property="id" column="id" />
        <result property="realName" column="real_name" />
        <result property="idCard" column="id_card" />
        <result property="price" column="price" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectParttimeSignupWhitelistVo">
        select id, real_name, id_card, price, status, remark, create_by, create_time, update_by, update_time
        from parttime_signup_whitelist
    </sql>

    <select id="selectParttimeSignupWhitelistByIdCard" parameterType="String" resultMap="ParttimeSignupWhitelistResult">
        <include refid="selectParttimeSignupWhitelistVo"/>
        where id_card = #{idCard}
        limit 1
    </select>

    <select id="selectEnabledParttimeSignupWhitelistByIdCard" parameterType="String" resultMap="ParttimeSignupWhitelistResult">
        <include refid="selectParttimeSignupWhitelistVo"/>
        where id_card = #{idCard} and status = 1
        limit 1
    </select>

    <select id="selectParttimeSignupWhitelistList" parameterType="ParttimeSignupWhitelist" resultMap="ParttimeSignupWhitelistResult">
        <include refid="selectParttimeSignupWhitelistVo"/>
        <where>
            <if test="realName != null and realName != ''">
                and real_name like concat('%', #{realName}, '%')
            </if>
            <if test="idCard != null and idCard != ''">
                and id_card like concat('%', #{idCard}, '%')
            </if>
        </where>
        order by create_time desc, id desc
    </select>

    <insert id="insertParttimeSignupWhitelist" parameterType="ParttimeSignupWhitelist">
        insert into parttime_signup_whitelist (
            id,
            real_name,
            id_card,
            price,
            status,
            remark,
            create_by,
            create_time,
            update_by,
            update_time
        ) values (
            #{id},
            #{realName},
            #{idCard},
            #{price},
            #{status},
            #{remark},
            #{createBy},
            #{createTime},
            #{updateBy},
            #{updateTime}
        )
    </insert>

    <delete id="deleteParttimeSignupWhitelistById" parameterType="Long">
        delete from parttime_signup_whitelist
        where id = #{id}
    </delete>
</mapper>
