<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ParentsMapper">

    <resultMap type="Parents" id="ParentsResult">
        <result property="id" column="id"/>
        <result property="wechatUid" column="wechat_uid"/>
        <result property="systemUid" column="system_uid"/>
        <result property="babyId" column="baby_id"/>
        <result property="addressId" column="address_id"/>
        <result property="location" column="location"/>
        <result property="geo" column="geo"/>
        <result property="region" column="region"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="grade" column="grade"/>
        <result property="subject" column="subject"/>
        <result property="methods" column="methods"/>
        <result property="demandItems" column="demand_items"/>
        <result property="genderRequirement" column="gender_requirement"/>
        <result property="hourlyBudget" column="hourly_budget"/>
        <result property="requirements" column="requirements"/>
        <result property="brief" column="brief"/>
        <result property="createDate" column="create_date"/>
        <result property="updateDate" column="update_date"/>
        <result property="status" column="status"/>
        <result property="dayOfWeek" column="day_of_week"/>
        <result property="serviceDates" column="service_dates"/>
        <result property="serviceTimes" column="service_times"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="bound" column="bound"/>
        <result property="parentName" column="parent_name"/>
        <result property="parentPhone" column="parent_phone"/>
        <result property="tutorName" column="tutor_name"/>
        <result property="studentPhone" column="student_phone"/>
    </resultMap>

    <sql id="selectParentsVo">
        select p.id, p.wechat_uid, p.system_uid, p.baby_id, p.address_id, p.location, p.geo, p.region, p.name, p.phone, p.grade, p.subject, p.methods,
               p.demand_items, p.gender_requirement, p.hourly_budget, p.requirements, p.brief, p.create_date, p.update_date, p.status, p.day_of_week, p.service_dates,
               p.service_times, p.start_time, p.end_time,
               tb_latest.id is not null as bound,
               coalesce(ui.real_name, ui.user_name) as parent_name,
               coalesce(ui.phone, p.phone) as parent_phone,
               coalesce(tui.real_name, tui.user_name) as tutor_name,
               tui.phone as student_phone
        from parents p
                 left join user_info ui on ui.id = p.system_uid
                 left join tutoring_binding tb_latest on tb_latest.id = (
                     select tb.id
                     from tutoring_binding tb
                     where tb.parent_id = p.id
                     order by tb.create_time desc, tb.id desc
                     limit 1
                 )
                 left join user_info tui on tui.id = tb_latest.tutor_user_id
    </sql>

    <select id="selectParentsList" parameterType="Parents" resultMap="ParentsResult">
        <include refid="selectParentsVo"/>
        <where>
            <if test="wechatUid != null"> and p.wechat_uid = #{wechatUid}</if>
            <if test="systemUid != null"> and p.system_uid = #{systemUid}</if>
            <if test="babyId != null"> and p.baby_id = #{babyId}</if>
            <if test="addressId != null"> and p.address_id = #{addressId}</if>
            <if test="location != null and location != ''"> and p.location = #{location}</if>
            <if test="geo != null and geo != ''"> and p.geo = #{geo}</if>
            <if test="region != null and region != ''"> and p.region = #{region}</if>
            <if test="name != null and name != ''"> and p.name like concat('%', #{name}, '%')</if>
            <if test="phone != null and phone != ''"> and p.phone = #{phone}</if>
            <if test="grade != null and grade != ''"> and p.grade = #{grade}</if>
            <if test="subject != null and subject != ''"> and p.subject = #{subject}</if>
            <if test="methods != null"> and p.methods = #{methods}</if>
            <if test="demandItems != null and demandItems != ''"> and p.demand_items = #{demandItems}</if>
            <if test="genderRequirement != null"> and p.gender_requirement = #{genderRequirement}</if>
            <if test="hourlyBudget != null"> and p.hourly_budget = #{hourlyBudget}</if>
            <if test="requirements != null and requirements != ''"> and p.requirements = #{requirements}</if>
            <if test="brief != null and brief != ''"> and p.brief = #{brief}</if>
            <if test="createDate != null"> and p.create_date = #{createDate}</if>
            <if test="updateDate != null"> and p.update_date = #{updateDate}</if>
            <if test="status != null"> and p.status = #{status}</if>
            <if test="dayOfWeek != null and dayOfWeek != ''"> and p.day_of_week = #{dayOfWeek}</if>
            <if test="serviceDates != null and serviceDates != ''"> and p.service_dates = #{serviceDates}</if>
            <if test="serviceTimes != null and serviceTimes != ''"> and p.service_times = #{serviceTimes}</if>
            <if test="startTime != null"> and p.start_time = #{startTime}</if>
            <if test="endTime != null"> and p.end_time = #{endTime}</if>
            <if test="bound != null and bound == true"> and tb_latest.id is not null</if>
            <if test="bound != null and bound == false"> and tb_latest.id is null</if>
        </where>
    </select>

    <select id="selectParentsById" parameterType="Long" resultMap="ParentsResult">
        <include refid="selectParentsVo"/>
        where p.id = #{id}
    </select>

    <select id="selectSingleParentByWechatUid" parameterType="String" resultMap="ParentsResult">
        <include refid="selectParentsVo"/>
        where p.wechat_uid = #{wechatUid}
        order by p.create_date desc, p.id desc
        limit 1
    </select>

    <select id="countParentsByWechatUid" parameterType="String" resultType="long">
        select count(1)
        from parents
        where wechat_uid = #{wechatUid}
    </select>

    <insert id="insertParents" parameterType="Parents">
        insert into parents
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="wechatUid != null">wechat_uid,</if>
            <if test="systemUid != null">system_uid,</if>
            <if test="babyId != null">baby_id,</if>
            <if test="addressId != null">address_id,</if>
            <if test="location != null">location,</if>
            <if test="geo != null">geo,</if>
            <if test="region != null">region,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="grade != null">grade,</if>
            <if test="subject != null">subject,</if>
            <if test="methods != null">methods,</if>
            <if test="demandItems != null and demandItems != ''">demand_items,</if>
            <if test="genderRequirement != null">gender_requirement,</if>
            <if test="hourlyBudget != null">hourly_budget,</if>
            <if test="requirements != null">requirements,</if>
            <if test="brief != null">brief,</if>
            <if test="createDate != null">create_date,</if>
            <if test="updateDate != null">update_date,</if>
            <if test="status != null">status,</if>
            <if test="dayOfWeek != null and dayOfWeek != ''">day_of_week,</if>
            <if test="serviceDates != null and serviceDates != ''">service_dates,</if>
            <if test="serviceTimes != null and serviceTimes != ''">service_times,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="wechatUid != null">#{wechatUid},</if>
            <if test="systemUid != null">#{systemUid},</if>
            <if test="babyId != null">#{babyId},</if>
            <if test="addressId != null">#{addressId},</if>
            <if test="location != null">#{location},</if>
            <if test="geo != null">#{geo},</if>
            <if test="region != null">#{region},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="grade != null">#{grade},</if>
            <if test="subject != null">#{subject},</if>
            <if test="methods != null">#{methods},</if>
            <if test="demandItems != null and demandItems != ''">#{demandItems},</if>
            <if test="genderRequirement != null">#{genderRequirement},</if>
            <if test="hourlyBudget != null">#{hourlyBudget},</if>
            <if test="requirements != null">#{requirements},</if>
            <if test="brief != null">#{brief},</if>
            <if test="createDate != null">#{createDate},</if>
            <if test="updateDate != null">#{updateDate},</if>
            <if test="status != null">#{status},</if>
            <if test="dayOfWeek != null and dayOfWeek != ''">#{dayOfWeek},</if>
            <if test="serviceDates != null and serviceDates != ''">#{serviceDates},</if>
            <if test="serviceTimes != null and serviceTimes != ''">#{serviceTimes},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
        </trim>
    </insert>

    <update id="updateParents" parameterType="Parents">
        update parents
        <trim prefix="SET" suffixOverrides=",">
            <if test="wechatUid != null">wechat_uid = #{wechatUid},</if>
            <if test="systemUid != null">system_uid = #{systemUid},</if>
            <if test="babyId != null">baby_id = #{babyId},</if>
            <if test="addressId != null">address_id = #{addressId},</if>
            <if test="location != null">location = #{location},</if>
            <if test="geo != null">geo = #{geo},</if>
            <if test="region != null">region = #{region},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="subject != null">subject = #{subject},</if>
            <if test="methods != null">methods = #{methods},</if>
            <if test="demandItems != null and demandItems != ''">demand_items = #{demandItems},</if>
            <if test="genderRequirement != null">gender_requirement = #{genderRequirement},</if>
            <if test="hourlyBudget != null">hourly_budget = #{hourlyBudget},</if>
            <if test="requirements != null">requirements = #{requirements},</if>
            <if test="brief != null">brief = #{brief},</if>
            <if test="createDate != null">create_date = #{createDate},</if>
            <if test="updateDate != null">update_date = #{updateDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="dayOfWeek != null and dayOfWeek != ''">day_of_week = #{dayOfWeek},</if>
            <if test="serviceDates != null and serviceDates != ''">service_dates = #{serviceDates},</if>
            <if test="serviceTimes != null and serviceTimes != ''">service_times = #{serviceTimes},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteParentsById" parameterType="Long">
        delete from parents where id = #{id}
    </delete>

    <delete id="deleteParentsByIds" parameterType="String">
        delete from parents where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
