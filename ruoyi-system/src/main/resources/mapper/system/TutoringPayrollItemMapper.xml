<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TutoringPayrollItemMapper">

    <resultMap id="TutoringPayrollItemResult" type="com.ruoyi.system.domain.TutoringPayrollItem">
        <result property="id" column="id"/>
        <result property="payrollNo" column="payroll_no"/>
        <result property="scheduleId" column="schedule_id"/>
        <result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="bindingId" column="binding_id"/>
        <result property="parentId" column="parent_id"/>
        <result property="parentUserId" column="parent_user_id"/>
        <result property="tutorId" column="tutor_id"/>
        <result property="tutorUserId" column="tutor_user_id"/>
        <result property="grossAmount" column="gross_amount"/>
        <result property="commissionRate" column="commission_rate"/>
        <result property="commissionAmount" column="commission_amount"/>
        <result property="netAmount" column="net_amount"/>
        <result property="status" column="status"/>
        <result property="walletBizId" column="wallet_biz_id"/>
        <result property="paidBy" column="paid_by"/>
        <result property="paidTime" column="paid_time"/>
        <result property="remark" column="remark"/>
        <result property="tutorName" column="tutor_name"/>
        <result property="parentName" column="parent_name"/>
        <result property="serviceDate" column="service_date"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="TutoringPayrollItemColumns">
        select pi.id,
               pi.payroll_no,
               pi.schedule_id,
               pi.order_id,
               pi.order_no,
               pi.binding_id,
               pi.parent_id,
               pi.parent_user_id,
               pi.tutor_id,
               pi.tutor_user_id,
               pi.gross_amount,
               pi.commission_rate,
               pi.commission_amount,
               pi.net_amount,
               pi.status,
               pi.wallet_biz_id,
               pi.paid_by,
               pi.paid_time,
               pi.remark,
               pi.create_by,
               pi.create_time,
               pi.update_by,
               pi.update_time,
               ui.user_name as tutor_name,
               p.name as parent_name,
               s.service_date,
               s.start_time,
               s.end_time
        from tutoring_payroll_item pi
                 left join user_info ui on ui.id = pi.tutor_user_id
                 left join parents p on p.id = pi.parent_id
                 left join tutoring_schedule s on s.id = pi.schedule_id
    </sql>

    <select id="selectPendingPayrollItems" parameterType="com.ruoyi.system.domain.TutoringPayrollItem" resultMap="TutoringPayrollItemResult">
        <include refid="TutoringPayrollItemColumns"/>
        <where>
            <if test="status != null">and pi.status = #{status}</if>
            <if test="tutorUserId != null">and pi.tutor_user_id = #{tutorUserId}</if>
            <if test="orderNo != null and orderNo != ''">and pi.order_no = #{orderNo}</if>
        </where>
        order by pi.create_time desc, pi.id desc
    </select>

    <select id="selectByScheduleId" resultMap="TutoringPayrollItemResult">
        <include refid="TutoringPayrollItemColumns"/>
        where pi.schedule_id = #{scheduleId}
        limit 1
    </select>

    <select id="selectByIdsForUpdate" resultMap="TutoringPayrollItemResult">
        <include refid="TutoringPayrollItemColumns"/>
        where pi.id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        for update
    </select>

    <insert id="insertTutoringPayrollItem" parameterType="com.ruoyi.system.domain.TutoringPayrollItem">
        insert into tutoring_payroll_item (
            id, payroll_no, schedule_id, order_id, order_no, binding_id, parent_id, parent_user_id,
            tutor_id, tutor_user_id, gross_amount, commission_rate, commission_amount, net_amount,
            status, wallet_biz_id, paid_by, paid_time, remark, create_by, create_time, update_by, update_time
        ) values (
            #{id}, #{payrollNo}, #{scheduleId}, #{orderId}, #{orderNo}, #{bindingId}, #{parentId}, #{parentUserId},
            #{tutorId}, #{tutorUserId}, #{grossAmount}, #{commissionRate}, #{commissionAmount}, #{netAmount},
            #{status}, #{walletBizId}, #{paidBy}, #{paidTime}, #{remark}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime}
        )
    </insert>

    <update id="updateTutoringPayrollItem" parameterType="com.ruoyi.system.domain.TutoringPayrollItem">
        update tutoring_payroll_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="walletBizId != null">wallet_biz_id = #{walletBizId},</if>
            <if test="paidBy != null">paid_by = #{paidBy},</if>
            <if test="paidTime != null">paid_time = #{paidTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>
</mapper>
