<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.WalletMapper">

    <!-- ============ user_wallet ============ -->
    <resultMap type="com.ruoyi.system.domain.UserWallet" id="WalletResult">
        <result property="id"             column="id"              />
        <result property="uid"            column="uid"             />
        <result property="balance"        column="balance"         />
        <result property="frozen"         column="frozen"          />
        <result property="totalEarned"    column="total_earned"    />
        <result property="totalWithdrawn" column="total_withdrawn" />
        <result property="createTime"     column="create_time"     />
        <result property="updateTime"     column="update_time"     />
    </resultMap>

    <select id="selectWalletByUid" parameterType="Long" resultMap="WalletResult">
        select id, uid, balance, frozen, total_earned, total_withdrawn,
               create_time, update_time
        from user_wallet
        where uid = #{uid}
    </select>

    <insert id="insertWallet" parameterType="com.ruoyi.system.domain.UserWallet" useGeneratedKeys="true" keyProperty="id">
        insert into user_wallet (uid, balance, frozen, total_earned, total_withdrawn)
        values (#{uid}, #{balance}, #{frozen}, #{totalEarned}, #{totalWithdrawn})
    </insert>

    <update id="updateWallet" parameterType="com.ruoyi.system.domain.UserWallet">
        update user_wallet
        <set>
            balance        = #{balance},
            frozen         = #{frozen},
            total_earned   = #{totalEarned},
            total_withdrawn = #{totalWithdrawn},
            update_time    = now()
        </set>
        where uid = #{uid}
    </update>

    <!-- ============ wallet_withdraw ============ -->
    <resultMap type="com.ruoyi.system.domain.WalletWithdraw" id="WithdrawResult">
        <result property="id"           column="id"             />
        <result property="uid"          column="uid"            />
        <result property="amount"       column="amount"         />
        <result property="status"       column="status"         />
        <result property="remark"       column="remark"         />
        <result property="wxTransferNo" column="wx_transfer_no" />
        <result property="applyTime"    column="create_time"    />
    </resultMap>

    <insert id="insertWithdraw" parameterType="com.ruoyi.system.domain.WalletWithdraw" useGeneratedKeys="true" keyProperty="id">
        insert into wallet_withdraw (uid, amount, status)
        values (#{uid}, #{amount}, #{status})
    </insert>

    <select id="selectWithdrawListByUid" resultMap="WithdrawResult">
        select id, uid, amount, status, remark, wx_transfer_no, create_time
        from wallet_withdraw
        where uid = #{uid}
        order by create_time desc
        limit 50
    </select>

    <select id="selectWithdrawById" parameterType="Long" resultMap="WithdrawResult">
        select id, uid, amount, status, remark, wx_transfer_no, create_time
        from wallet_withdraw
        where id = #{id}
    </select>

    <update id="updateWithdrawStatus" parameterType="com.ruoyi.system.domain.WalletWithdraw">
        update wallet_withdraw
        <set>
            status        = #{status},
            remark        = #{remark},
            wx_transfer_no = #{wxTransferNo},
            update_time   = now()
        </set>
        where id = #{id}
    </update>

</mapper>
