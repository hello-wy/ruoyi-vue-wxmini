<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MerchantUserTypeWhitelistMapper">

    <resultMap type="MerchantUserTypeWhitelist" id="MerchantUserTypeWhitelistResult">
        <result property="id" column="id" />
        <result property="realName" column="real_name" />
        <result property="idCard" column="id_card" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectMerchantUserTypeWhitelistVo">
        select id, real_name, id_card, status, remark, create_by, create_time, update_by, update_time
        from merchant_user_type_whitelist
    </sql>

    <select id="selectMerchantUserTypeWhitelistByIdCard" parameterType="String" resultMap="MerchantUserTypeWhitelistResult">
        <include refid="selectMerchantUserTypeWhitelistVo"/>
        where id_card = #{idCard}
        limit 1
    </select>

    <select id="selectEnabledMerchantUserTypeWhitelistByIdCard" parameterType="String" resultMap="MerchantUserTypeWhitelistResult">
        <include refid="selectMerchantUserTypeWhitelistVo"/>
        where id_card = #{idCard} and status = 1
        limit 1
    </select>

    <select id="selectMerchantUserTypeWhitelistList" parameterType="MerchantUserTypeWhitelist" resultMap="MerchantUserTypeWhitelistResult">
        <include refid="selectMerchantUserTypeWhitelistVo"/>
        <where>
            <if test="idCard != null and idCard != ''"> and id_card = #{idCard}</if>
            <if test="realName != null and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="status != null"> and status = #{status}</if>
        </where>
        order by create_time desc, id desc
    </select>

    <insert id="insertMerchantUserTypeWhitelist" parameterType="MerchantUserTypeWhitelist">
        insert into merchant_user_type_whitelist (
            id,
            real_name,
            id_card,
            status,
            remark,
            create_by,
            create_time,
            update_by
        ) values (
            #{id},
            #{realName},
            #{idCard},
            #{status},
            #{remark},
            #{createBy},
            #{createTime},
            #{updateBy}
        )
    </insert>

    <delete id="deleteMerchantUserTypeWhitelistByIds" parameterType="String">
        delete from merchant_user_type_whitelist where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
