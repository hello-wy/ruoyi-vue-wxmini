<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MiniUserMapper">
    <resultMap id="MiniUserVoResult" type="com.ruoyi.system.domain.vo.MiniUserVo">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="userType" column="user_type"/>
        <result property="phone" column="phone"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="realName" column="real_name"/>
        <result property="gender" column="gender"/>
        <result property="isRealnameAuth" column="is_realname_auth"/>
        <result property="isStudent" column="is_student"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="MiniUserColumns">
        select ui.id, ui.user_id, ui.user_name, ui.user_type, ui.phone, ui.avatar_url, ui.real_name,
               up.gender, ui.is_realname_auth, ui.is_student, ui.create_time, ui.update_time
        from user_info ui
        left join wx_user_profile up on up.uid = ui.id
    </sql>

    <select id="selectMiniUserList" resultMap="MiniUserVoResult">
        <include refid="MiniUserColumns"/>
        <where>
            <if test="keyword != null and keyword != ''">
                and (ui.user_name like concat('%', #{keyword}, '%')
                     or ui.real_name like concat('%', #{keyword}, '%')
                     or ui.phone like concat('%', #{keyword}, '%')
                     or ui.user_id like concat('%', #{keyword}, '%'))
            </if>
            <if test="userType != null">and ui.user_type = #{userType}</if>
            <if test="isStudent != null">and ui.is_student = #{isStudent}</if>
        </where>
        order by ui.create_time desc, ui.id desc
    </select>

    <select id="selectMiniUserById" resultMap="MiniUserVoResult">
        <include refid="MiniUserColumns"/>
        where ui.id = #{id}
    </select>
</mapper>
