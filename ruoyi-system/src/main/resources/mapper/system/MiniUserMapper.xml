<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.MiniUserMapper">
    <resultMap id="MiniUserVoResult" type="com.ruoyi.system.domain.vo.MiniUserVo">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="userType" column="user_type"/>
        <result property="phone" column="phone"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="realName" column="real_name"/>
        <result property="isRealnameAuth" column="is_realname_auth"/>
        <result property="isStudent" column="is_student"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="MiniUserColumns">
        select id, user_id, user_name, user_type, phone, avatar_url, real_name,
               is_realname_auth, is_student, create_time, update_time
        from user_info
    </sql>

    <select id="selectMiniUserList" resultMap="MiniUserVoResult">
        <include refid="MiniUserColumns"/>
        <where>
            <if test="keyword != null and keyword != ''">
                and (user_name like concat('%', #{keyword}, '%')
                     or real_name like concat('%', #{keyword}, '%')
                     or phone like concat('%', #{keyword}, '%')
                     or user_id like concat('%', #{keyword}, '%'))
            </if>
            <if test="userType != null">and user_type = #{userType}</if>
            <if test="isStudent != null">and is_student = #{isStudent}</if>
        </where>
        order by create_time desc, id desc
    </select>

    <select id="selectMiniUserById" resultMap="MiniUserVoResult">
        <include refid="MiniUserColumns"/>
        where id = #{id}
    </select>
</mapper>
