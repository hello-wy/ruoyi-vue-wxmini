<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SalonPayOrderMapper">

    <resultMap type="com.ruoyi.system.domain.SalonPayOrder" id="SalonPayOrderResult">
        <result property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="wechatTransactionId" column="wechat_transaction_id"/>
        <result property="userId" column="user_id"/>
        <result property="salonId" column="salon_id"/>
        <result property="title" column="title"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="payTime" column="pay_time"/>
        <result property="requestId" column="request_id"/>
        <result property="refundNo" column="refund_no"/>
        <result property="refundTime" column="refund_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSalonPayOrderVo">
        select id, order_no, wechat_transaction_id, user_id, salon_id, amount, status, pay_time, request_id, refund_no, refund_time, create_time, update_time
        from salon_pay_order
    </sql>

    <select id="selectSalonPayOrderByOrderNo" parameterType="String" resultMap="SalonPayOrderResult">
        <include refid="selectSalonPayOrderVo"/>
        where order_no = #{orderNo}
    </select>

    <select id="selectSalonPayOrderList" parameterType="com.ruoyi.system.domain.SalonPayOrder" resultMap="SalonPayOrderResult">
        <include refid="selectSalonPayOrderVo"/>
        <where>
            <if test="orderNo != null and orderNo != ''">and order_no = #{orderNo}</if>
            <if test="userId != null and userId != ''">and user_id = #{userId}</if>
            <if test="salonId != null">and salon_id = #{salonId}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectMySalonOrders" resultMap="SalonPayOrderResult">
        select spo.id,
               spo.order_no,
               spo.wechat_transaction_id,
               spo.user_id,
               spo.salon_id,
               si.title,
               spo.amount,
               spo.status,
               spo.pay_time,
               spo.request_id,
               spo.create_time,
               spo.update_time
        from salon_pay_order spo
                 left join salon_info si on si.id = spo.salon_id
        where spo.user_id = #{userId}
        order by spo.create_time desc, spo.id desc
    </select>

    <resultMap id="StudentSalonPurchaseRecordResult" type="com.ruoyi.system.domain.vo.StudentSalonPurchaseRecordVo">
        <result property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="salonId" column="salon_id"/>
        <result property="salonTitle" column="salon_title"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="payTime" column="pay_time"/>
        <result property="refundTime" column="refund_time"/>
    </resultMap>

    <select id="selectStudentSalonPurchaseRecords" resultMap="StudentSalonPurchaseRecordResult">
        select spo.id,
               spo.order_no,
               spo.salon_id,
               si.title as salon_title,
               spo.amount,
               spo.status,
               spo.pay_time,
               spo.refund_time
        from salon_pay_order spo
                 inner join user_info ui on ui.user_id = spo.user_id
                 left join salon_info si on si.id = spo.salon_id
        where ui.id = #{studentId}
          and spo.status in ('PAID', 'REFUNDED')
        order by spo.pay_time desc, spo.id desc
    </select>

    <select id="selectLatestPaidOrderByUserIdAndSalonId" resultMap="SalonPayOrderResult">
        <include refid="selectSalonPayOrderVo"/>
        where user_id = #{userId}
          and salon_id = #{salonId}
          and status = 'PAID'
        order by pay_time desc, id desc
        limit 1
    </select>

    <insert id="insertSalonPayOrder" parameterType="com.ruoyi.system.domain.SalonPayOrder" useGeneratedKeys="true" keyProperty="id">
        insert into salon_pay_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="wechatTransactionId != null and wechatTransactionId != ''">wechat_transaction_id,</if>
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="salonId != null">salon_id,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="payTime != null">pay_time,</if>
            <if test="requestId != null and requestId != ''">request_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="wechatTransactionId != null and wechatTransactionId != ''">#{wechatTransactionId},</if>
            <if test="userId != null and userId != ''">#{userId},</if>
            <if test="salonId != null">#{salonId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="payTime != null">#{payTime},</if>
            <if test="requestId != null and requestId != ''">#{requestId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateSalonPayOrder" parameterType="com.ruoyi.system.domain.SalonPayOrder">
        update salon_pay_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="wechatTransactionId != null and wechatTransactionId != ''">wechat_transaction_id = #{wechatTransactionId},</if>
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="salonId != null">salon_id = #{salonId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="requestId != null and requestId != ''">request_id = #{requestId},</if>
            <if test="refundNo != null">refund_no = #{refundNo},</if>
            <if test="refundTime != null">refund_time = #{refundTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <!-- 沙龙退款列表 VO 映射 -->
    <resultMap id="SalonRefundOrderResult" type="com.ruoyi.system.domain.vo.SalonRefundOrderVo">
        <result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="salonId" column="salon_id"/>
        <result property="title" column="title"/>
        <result property="userName" column="user_name"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="payTime" column="pay_time"/>
        <result property="refundTime" column="refund_time"/>
    </resultMap>

    <!-- 查询已支付的沙龙订单列表（联表含沙龙标题、支付人姓名，用于退款管理） -->
    <select id="selectPaidSalonOrders" resultMap="SalonRefundOrderResult">
        SELECT spo.id                                             AS order_id,
               spo.order_no,
               spo.user_id,
               spo.salon_id,
               si.title                                           AS title,
               ui.real_name                                       AS user_name,
               spo.amount,
               spo.status,
               spo.pay_time,
               spo.refund_time
        FROM salon_pay_order spo
                 LEFT JOIN salon_info si ON si.id = spo.salon_id
                 LEFT JOIN user_info ui ON ui.user_id = spo.user_id
                 LEFT JOIN wx_user_profile up ON up.uid = ui.id
        WHERE spo.status IN ('PAID', 'REFUNDED')
        <if test="salonId != null">
            AND spo.salon_id = #{salonId}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (
                ui.real_name = #{keyword}
                OR (
                    #{keyword} REGEXP '^[0-9A-Za-z]+$'
                    AND (spo.order_no LIKE CONCAT('%', #{keyword}, '%')
                         OR CAST(spo.order_no AS DECIMAL(30)) = CAST(#{keyword} AS DECIMAL(30)))
                )
            )
        </if>
        ORDER BY spo.create_time DESC
    </select>
</mapper>
